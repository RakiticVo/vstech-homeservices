# Development — copy to .env.development (gitignored) and fill in real values.
# Run: flutter run --dart-define-from-file=.env.development

APP_ENV=development

# REST API origin (UAT backend)
API_BASE_URL=https://homeservice-uat.vitinhkimhung.com
# WebSocket origin — leave empty to derive from API_BASE_URL
WS_BASE_URL=
# In-app debug console for testers (floating bug button). true | false
DEBUG_CONSOLE=true

# trace | debug | info | warning | error | off
LOG_LEVEL=debug

# Google Maps key for the tracking map
GOOGLE_MAPS_API_KEY=

# UAT test accounts from the backend team — local manual testing only
TEST_CUSTOMER_PHONE=
TEST_CUSTOMER_PASSWORD=
TEST_WORKER_PHONE=
TEST_WORKER_PASSWORD=
