# Production — copy to .env.production (gitignored) and fill in real values.
# Run: flutter build apk --release --dart-define-from-file=.env.production

APP_ENV=production

# REST API origin — TODO: production URL from the backend team (required)
API_BASE_URL=
# WebSocket origin — leave empty to derive from API_BASE_URL
WS_BASE_URL=
# In-app debug console for testers — keep false in production
DEBUG_CONSOLE=false

# trace | debug | info | warning | error | off
LOG_LEVEL=warning

# Google Maps key for the tracking map (production key)
GOOGLE_MAPS_API_KEY=
