# Copy to .env (gitignored) and fill in real values.
# Run: flutter run --dart-define-from-file=.env

# REST API origin (default: UAT)
API_BASE_URL=https://homeservice-uat.vitinhkimhung.com
# WebSocket origin — leave empty to derive from API_BASE_URL
WS_BASE_URL=
# trace | debug | info | warning | error
LOG_LEVEL=debug

# Google Maps key for the tracking map
GOOGLE_MAPS_API_KEY=

# UAT test accounts from the backend team — local manual testing only
TEST_CUSTOMER_PHONE=
TEST_CUSTOMER_PASSWORD=
TEST_WORKER_PHONE=
TEST_WORKER_PASSWORD=
